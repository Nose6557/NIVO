    {
      "id": "a1-be-forms-01",
      "topic": "a1-be-forms",
      "level": "A1",
      "type": "fill",
      "prompt": "I ___ from Ukraine.",
      "answer": "am",
      "accept": [
        "am"
      ],
      "explain": "З «I» завжди вживається am.\nВ українській «Я з України» дієслова немає — в англійській воно обов'язкове.",
      "ua": "Я з України."
    },
    {
      "id": "a1-be-forms-02",
      "topic": "a1-be-forms",
      "level": "A1",
      "type": "mcq",
      "prompt": "My parents ___ at home.",
      "options": [
        "are",
        "is",
        "am",
        "be"
      ],
      "answer": "are",
      "explain": "Підмет у множині (parents) → are.\n✗ is — для однини (he, she, it).\n✗ am — тільки з I.\n✗ be — базова форма, у теперішньому часі так не вживається.",
      "ua": "Мої батьки вдома."
    },
    {
      "id": "a1-be-required-01",
      "topic": "a1-be-required",
      "level": "A1",
      "type": "mcq",
      "prompt": "She ___ a doctor.",
      "options": [
        "is",
        "—",
        "be",
        "are"
      ],
      "answer": "is",
      "explain": "Українською кажемо «Вона лікарка» — без дієслова. В англійському реченні дієслово ОБОВ'ЯЗКОВЕ: She is a doctor.\n✗ без дієслова — найчастіша помилка українців на цьому рівні.\n✗ be / are — неправильна форма для she.",
      "ua": "Вона лікарка."
    },
    {
      "id": "a1-be-required-02",
      "topic": "a1-be-required",
      "level": "A1",
      "type": "mcq",
      "prompt": "We ___ students.",
      "options": [
        "are",
        "—",
        "is",
        "am"
      ],
      "answer": "are",
      "explain": "«Ми студенти» англійською вимагає are: We are students.\n✗ без дієслова — калька з української.\n✗ is / am — не узгоджуються з we.",
      "ua": "Ми студенти."
    },
    {
      "id": "a1-be-negative-01",
      "topic": "a1-be-negative",
      "level": "A1",
      "type": "mcq",
      "prompt": "He ___ at work today.",
      "options": [
        "isn't",
        "doesn't",
        "not",
        "don't"
      ],
      "answer": "isn't",
      "explain": "Заперечення до дієслова be утворюється додаванням not: he is not = he isn't.\n✗ doesn't / don't — вживаються з іншими дієсловами (he doesn't work), а не з be.\n✗ not — саме по собі не може заперечувати.",
      "ua": "Його сьогодні немає на роботі."
    },
    {
      "id": "a1-be-negative-02",
      "topic": "a1-be-negative",
      "level": "A1",
      "type": "mcq",
      "prompt": "They ___ ready yet.",
      "options": [
        "aren't",
        "don't",
        "not are",
        "isn't"
      ],
      "answer": "aren't",
      "explain": "are + not = aren't.\n✗ don't — з be не вживається.\n✗ not are — хибний порядок слів.\n✗ isn't — однина, а they — множина.",
      "ua": "Вони ще не готові."
    },
    {
      "id": "a1-age-be-01",
      "topic": "a1-age-be",
      "level": "A1",
      "type": "mcq",
      "prompt": "I ___ twenty-five.",
      "options": [
        "am",
        "have",
        "have got",
        "is"
      ],
      "answer": "am",
      "explain": "Вік англійською виражається через be: I am 25 (буквально «я є 25»).\n✗ have / have got — калька з української «мені 25 років» через «мати»; англійською так не кажуть.\n✗ is — не поєднується з I.",
      "ua": "Мені двадцять п'ять."
    },
    {
      "id": "a1-age-be-02",
      "topic": "a1-age-be",
      "level": "A1",
      "type": "mcq",
      "prompt": "How old ___ your brother?",
      "options": [
        "is",
        "has",
        "does",
        "are"
      ],
      "answer": "is",
      "explain": "Питання про вік: How old is …? — знову дієслово be.\n✗ has — «скільки років має» — калька.\n✗ does — з be не вживається.\n✗ are — brother в однині.",
      "ua": "Скільки років твоєму братові?"
    },
    {
      "id": "a1-have-got-01",
      "topic": "a1-have-got",
      "level": "A1",
      "type": "mcq",
      "prompt": "She ___ two brothers.",
      "options": [
        "has got",
        "have got",
        "is got",
        "got"
      ],
      "answer": "has got",
      "explain": "У 3-й особі однини — has got: She has got two brothers.\n✗ have got — форма для I/you/we/they.\n✗ is got — be тут не вживається.\n✗ got — без has речення неповне.",
      "ua": "У неї двоє братів."
    },
    {
      "id": "a1-have-got-02",
      "topic": "a1-have-got",
      "level": "A1",
      "type": "mcq",
      "prompt": "___ you got a pen?",
      "options": [
        "Have",
        "Do",
        "Are",
        "Has"
      ],
      "answer": "Have",
      "explain": "Питання з have got починається з Have/Has: Have you got …?\n✗ Do — тоді потрібна інша форма: Do you have a pen?\n✗ Are — be тут недоречне.\n✗ Has — не узгоджується з you.",
      "ua": "У тебе є ручка?"
    },
    {
      "id": "a1-art-a-an-basic-01",
      "topic": "a1-art-a-an-basic",
      "level": "A1",
      "type": "mcq",
      "prompt": "This is ___ apple.",
      "options": [
        "an",
        "a",
        "the",
        "—"
      ],
      "answer": "an",
      "explain": "«apple» починається з голосного звуку → an.\n✗ a — перед приголосним звуком.\n✗ the — для вже відомого предмета.\n✗ без артикля — злічуваний іменник в однині завжди з артиклем (в українській артиклів немає, тому їх легко забути).",
      "ua": "Це яблуко."
    },
    {
      "id": "a1-art-a-an-basic-02",
      "topic": "a1-art-a-an-basic",
      "level": "A1",
      "type": "mcq",
      "prompt": "I have ___ dog.",
      "options": [
        "a",
        "an",
        "the",
        "—"
      ],
      "answer": "a",
      "explain": "«dog» починається з приголосного звуку → a dog.\n✗ an — перед голосним звуком.\n✗ the — собака згадується вперше.\n✗ без артикля — типова помилка через відсутність артиклів в українській.",
      "ua": "У мене є собака."
    },
    {
